# ---------------------------------------------------------------------------
# Rhytara Certificate Issuance - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
# There is no Shopify integration in this system. Every certificate is
# issued manually from the dashboard - a staff member types in the order
# number, customer name/email, design, and certificate number, and the
# system generates and emails the PDF.
# ---------------------------------------------------------------------------

# ---- Email ------------------------------------------------------------------
# "resend" (dedicated provider, sends as your own domain), "gmail" (sends via
# a real Gmail inbox), or "console" (dev/test - just logs, sends nothing).
EMAIL_PROVIDER=console
EMAIL_FROM="Rhytara <certificates@rhytara.com>"
EMAIL_REPLY_TO=hello@rhytara.com

# EMAIL_PROVIDER=resend only.
EMAIL_API_KEY=

# EMAIL_PROVIDER=gmail only. GMAIL_APP_PASSWORD is a 16-character App
# Password from https://myaccount.google.com/apppasswords - requires
# 2-Step Verification turned on for that Google account first. The regular
# account password will NOT work here.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Certificate storage -----------------------------------------------------
# "s3" (S3-compatible object storage with signed URLs) or "local" (dev/test -
# saves under ./local-storage and serves via this app; not for production).
CERTIFICATE_STORAGE_PROVIDER=local
CERTIFICATE_STORAGE_BUCKET=
CERTIFICATE_STORAGE_REGION=
CERTIFICATE_STORAGE_ACCESS_KEY=
CERTIFICATE_STORAGE_SECRET_KEY=
# Optional: only needed for non-AWS S3-compatible providers (R2, Backblaze, etc).
CERTIFICATE_STORAGE_ENDPOINT=
# Seconds a signed download URL stays valid.
CERTIFICATE_STORAGE_SIGNED_URL_TTL_SECONDS=604800
# Only used by the "local" storage provider (dev/test) to sign download
# links served by this app. Generate with: openssl rand -hex 32
CERTIFICATE_LINK_SECRET=

# ---- App ----------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
PORT=3000

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rhytara_certificates

# ---- Test mode ------------------------------------------------------------------
# true: generate + store the certificate and log the URL, but email TEST_EMAIL
# instead of the real customer. false: email the real customer.
CERTIFICATE_TEST_MODE=true
TEST_EMAIL=you@example.com

# Shared secret required in the `x-admin-token` header on /admin/dashboard/api/*.
# Also what you type into the dashboard's login screen. Generate with:
# openssl rand -hex 32
ADMIN_API_TOKEN=
