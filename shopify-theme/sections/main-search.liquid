<section class="page-hero">
  <div class="wrap">
    <h1 class="hero-h1 rv">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="{{ 'general.search.placeholder' | t }}"
             aria-label="{{ 'general.search.search' | t }}">
      <button type="submit" class="btn-olive">{{ 'general.search.search' | t }}</button>
    </form>
  </div>
</section>

<section class="grid-section">
  <div class="wrap">
    {%- if search.performed -%}
      <p class="sec-sub">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
      <div class="artwork-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search" }
{% endschema %}
