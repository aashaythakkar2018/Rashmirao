{%- comment -%}
  Product page. Everything product-specific comes from the product record, so
  adding a work in admin is enough - no theme edit. The two optional spec
  accordions render only when their metafield is filled, which keeps a
  minimally-filled product (title, price, images, description) looking right.
{%- endcomment -%}

{%- assign spec = product.metafields.custom.specifications -%}
{%- assign care = product.metafields.custom.medium_care -%}
{%- assign quote = product.metafields.custom.artist_quote -%}
{%- assign edition = product.metafields.custom.edition -%}

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span aria-hidden="true">/</span>
  {%- if collection -%}
    <a href="{{ collection.url }}">{{ collection.title }}</a>
    <span aria-hidden="true">/</span>
  {%- endif -%}
  <span aria-current="page">{{ product.title }}</span>
</nav>

<div class="product-page">
  <div class="gallery" id="gallery">
    <div class="gallery-border"></div>

    <div class="thumbs" id="thumbStrip">
      {%- for image in product.images -%}
        <button class="thumb{% if forloop.first %} active{% endif %}"
                type="button"
                onclick="selectImage({{ forloop.index0 }}, this)"
                aria-label="View image {{ forloop.index }}">
          <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | escape }}"
               width="90" height="90" loading="lazy" decoding="async">
        </button>
      {%- endfor -%}
    </div>

    <div class="main-image-wrap" id="mainWrap">
      {%- if product.metafields.custom.badge != blank -%}
        <span class="img-badge" id="imgBadge">{{ product.metafields.custom.badge }}</span>
      {%- elsif product.available == false -%}
        <span class="img-badge" id="imgBadge">Sold</span>
      {%- endif -%}

      {%- if product.featured_image -%}
        <img class="main-img" id="mainImg"
             src="{{ product.featured_image | image_url: width: 1400 }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             width="1400" height="1400" fetchpriority="high" decoding="async">
      {%- endif -%}
    </div>
  </div>

  <div class="product-info">
    <p class="pi-category">{{ product.type | default: product.vendor }}</p>
    <h1 class="pi-title">{{ product.title }}</h1>

    {%- if product.metafields.custom.medium != blank -%}
      <p class="pi-medium">{{ product.metafields.custom.medium }}</p>
    {%- endif -%}

    {%- if edition != blank -%}
      <div class="edition-badge">
        <span>{{ edition }}</span>
      </div>
    {%- endif -%}

    <div class="pi-price-row">
      <span class="pi-price" id="productPrice">{{ product.selected_or_first_available_variant.price | money }}</span>
      {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
        <s class="pi-price-was">{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
      {%- endif -%}
      <span class="pi-price-label">{{ cart.currency.iso_code }}</span>
    </div>
    <p class="pi-tax-note">{{ 'products.product.tax_note' | t }}</p>

    <div class="pi-availability">
      <span>
        {%- if product.available -%}
          {{ section.settings.availability_text }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </div>

    <div class="pi-divider"></div>

    {%- form 'product', product, id: 'ProductForm', novalidate: 'novalidate' -%}
      {%- comment -%}
        Only render option pills when the product genuinely has options. The
        static site showed a "Print Size" choice on every product, including
        one-of-one paintings that have no such choice.
      {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="option-group">
            <div class="option-label">{{ option.name }}</div>
            <div class="option-pills">
              {%- for value in option.values -%}
                <button type="button"
                        class="option-pill{% if option.selected_value == value %} active{% endif %}"
                        data-option-index="{{ option.position }}"
                        data-value="{{ value | escape }}"
                        onclick="selectOption(this)">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <select name="id" id="variantSelect" class="visually-hidden" aria-hidden="true" tabindex="-1">
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                  data-price="{{ variant.price | money }}">
            {{ variant.title }}
          </option>
        {%- endfor -%}
      </select>

      <div class="cta-stack">
        <button type="submit" name="add" class="btn-primary" id="addToCartBtn"
                {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}
            {{ section.settings.add_to_cart_label }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
        {%- if section.settings.enquiry_page != blank -%}
          <a class="btn-secondary" href="{{ section.settings.enquiry_page.url }}">
            {{ section.settings.enquiry_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endform -%}

    <div class="ships-in">{{ section.settings.shipping_note }}</div>

    <div class="accordion">
      <div class="accordion-item open">
        <button class="acc-trigger" type="button" onclick="toggleAcc(this)">
          About the Work
          <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="acc-body"><div class="acc-content">
          {{ product.description }}
          {%- if quote != blank -%}<p><em>{{ quote }}</em></p>{%- endif -%}
        </div></div>
      </div>

      {%- if spec != blank -%}
        <div class="accordion-item">
          <button class="acc-trigger" type="button" onclick="toggleAcc(this)">
            Dimensions &amp; Specifications
            <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="acc-body"><div class="acc-content">
            {% render 'spec-table', value: spec %}
          </div></div>
        </div>
      {%- endif -%}

      {%- if care != blank -%}
        <div class="accordion-item">
          <button class="acc-trigger" type="button" onclick="toggleAcc(this)">
            Medium &amp; Care
            <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="acc-body"><div class="acc-content">
            {% render 'spec-table', value: care %}
          </div></div>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          <div class="accordion-item" {{ block.shopify_attributes }}>
            <button class="acc-trigger" type="button" onclick="toggleAcc(this)">
              {{ block.settings.heading }}
              <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="acc-body"><div class="acc-content">{{ block.settings.content }}</div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Related products: same collection, never the product itself. {%- endcomment -%}
{%- assign rel = collection.products | default: product.collections.first.products -%}
{%- if rel.size > 1 -%}
  <section class="related">
    <div class="related-header">
      <h2 class="related-title">{{ section.settings.related_heading }}</h2>
      <a href="{{ routes.all_products_collection_url }}" class="related-link">View All Works &rarr;</a>
    </div>
    <div class="related-grid">
      {%- assign shown = 0 -%}
      {%- for p in rel -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<div class="toast" id="toast"></div>

<script>
  /* Real CDN URLs at the size we display, built by Liquid - product.images
     yields image drops, not strings, so they cannot be used directly in JS. */
  var GALLERY = [
    {%- for image in product.images -%}
      { src: {{ image | image_url: width: 1400 | json }},
        alt: {{ image.alt | default: product.title | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  function selectImage(i, el) {
    var main = document.getElementById('mainImg');
    if (main && GALLERY[i]) { main.src = GALLERY[i].src; main.alt = GALLERY[i].alt; }
    document.querySelectorAll('.thumb').forEach(function (t) { t.classList.remove('active'); });
    if (el) el.classList.add('active');
  }

  function toggleAcc(btn) {
    btn.parentElement.classList.toggle('open');
  }

  /* Option pills drive the hidden <select name="id"> that the form posts. */
  var VARIANTS = {{ product.variants | json }};
  function selectOption(btn) {
    var group = btn.closest('.option-pills');
    group.querySelectorAll('.option-pill').forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');

    var chosen = [];
    document.querySelectorAll('.option-pills').forEach(function (g) {
      var active = g.querySelector('.option-pill.active');
      if (active) chosen.push(active.dataset.value);
    });

    var match = VARIANTS.find(function (v) {
      return v.options.every(function (o, i) { return o === chosen[i]; });
    });
    if (!match) return;

    document.getElementById('variantSelect').value = match.id;
    var price = document.getElementById('productPrice');
    if (price) price.textContent = (match.price / 100).toLocaleString(undefined, {
      style: 'currency', currency: {{ cart.currency.iso_code | json }}
    });
    var btnAdd = document.getElementById('addToCartBtn');
    if (btnAdd) {
      btnAdd.disabled = !match.available;
      btnAdd.textContent = match.available ? {{ section.settings.add_to_cart_label | json }} : 'Sold';
    }
    if (history.replaceState) {
      history.replaceState({}, '', '?variant=' + match.id);
    }
  }

  /* Submit through the AJAX cart so the drawer opens instead of navigating. */
  document.getElementById('ProductForm').addEventListener('submit', function (e) {
    e.preventDefault();
    addToCart(document.getElementById('variantSelect').value, 1);
  });
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Purchase This Work" },
    { "type": "text", "id": "enquiry_label", "label": "Secondary button label", "default": "Connect with Artist" },
    { "type": "page", "id": "enquiry_page", "label": "Secondary button page" },
    { "type": "text", "id": "availability_text", "label": "Availability line",
      "default": "Available · Ships in 4-6 weeks with archival packaging" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note",
      "default": "Ships in 4-6 weeks. Archival foam packaging, fully insured" },
    { "type": "text", "id": "related_heading", "label": "Related heading", "default": "From the Same Series" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "accordion", "settings": { "heading": "Shipping & Returns" } },
      { "type": "accordion", "settings": { "heading": "Certificate of Authenticity" } }
    ]
  }
}
{% endschema %}
