{%- if section.settings.text != blank -%}
  <div class="ann" id="ann">
    {{ section.settings.text }}
    <button class="ann-close" onclick="closeAnn()" aria-label="{{ 'accessibility.close' | t }}">&times;</button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement",
      "default": "Nature's Rhythm — the first collection from Rhytara. Five designs now available."
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
