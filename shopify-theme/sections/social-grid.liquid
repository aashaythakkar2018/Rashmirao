<section class="social-bg section">
  <div class="wrap">
    <div class="social-hd">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.hashtag != blank -%}
        <span class="social-tag">{{ section.settings.hashtag }}</span>
      {%- endif -%}
    </div>

    <div class="social-grid">
      {%- comment -%}
        With no blocks added yet (a fresh section on a fresh install), show
        six bundled studio shots rather than an empty grid - the merchant
        swaps them for real Instagram exports whenever they add blocks.
      {%- endcomment -%}
      {%- assign fallback_count = 6 -%}
      {%- assign posts = section.blocks -%}
      {%- if posts.size == 0 -%}
        {%- for i in (1..6) -%}
          <a href="{{ section.settings.profile_url | default: settings.social_instagram_link }}"
             target="_blank" rel="noopener" class="social-card rv">
            <div class="img-wrap" style="height:100%;">
              <img src="{{ 'social-fallback-0' | append: i | append: '.jpg' | asset_url }}" alt="" loading="lazy" decoding="async">
            </div>
            <div class="social-overlay">
              <div class="social-ig">{% render 'icon-social', platform: 'instagram' %}</div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in posts -%}
          <a href="{{ block.settings.url | default: section.settings.profile_url }}"
             target="_blank" rel="noopener" class="social-card rv" {{ block.shopify_attributes }}>
            <div class="img-wrap" style="height:100%;">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.image.alt | escape }}" loading="lazy" decoding="async">
              {%- else -%}
                {%- assign fallback_index = forloop.index0 | modulo: fallback_count | plus: 1 -%}
                <img src="{{ 'social-fallback-0' | append: fallback_index | append: '.jpg' | asset_url }}" alt="" loading="lazy" decoding="async">
              {%- endif -%}
            </div>
            <div class="social-overlay">
              <div class="social-ig">{% render 'icon-social', platform: 'instagram' %}</div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social grid",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading", "default": "Living With <em>the Work.</em>" },
    { "type": "text", "id": "hashtag", "label": "Hashtag" },
    { "type": "url", "id": "profile_url", "label": "Default profile link" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Social grid" }]
}
{% endschema %}
