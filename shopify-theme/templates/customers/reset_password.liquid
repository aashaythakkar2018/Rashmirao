<section class="section"><div class="wrap" style="max-width:440px;">
  <h1 class="sec-h2">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="rp-pass">New password</label>
    <input type="password" name="customer[password]" id="rp-pass" autocomplete="new-password">
    <label for="rp-conf">Confirm</label>
    <input type="password" name="customer[password_confirmation]" id="rp-conf" autocomplete="new-password">
    <button type="submit" class="btn-olive">Reset</button>
  {%- endform -%}
</div></section>
