{%- comment -%}
  Elegant placeholder for a product with no image yet, so a freshly added
  product never shows a broken image icon or empty box. Uses the theme's own
  monogram mark on a soft gradient, at the same aspect ratio as a real photo.
  Accepts: title (optional, for the aria-label).
{%- endcomment -%}
<div class="product-fallback" role="img" aria-label="{{ title | default: 'Artwork image coming soon' | escape }}">
  <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id="pf-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--beige, #E9E3DB)"/>
        <stop offset="100%" stop-color="var(--bg, #FAF8F5)"/>
      </linearGradient>
    </defs>
    <rect width="400" height="400" fill="url(#pf-grad)"/>
    <circle cx="200" cy="185" r="72" fill="none" stroke="var(--olive, #6D7550)" stroke-width="1.5" opacity="0.55"/>
    <path d="M172 160h30a20 20 0 010 40h-30v-40zm0 40l35 45" fill="none" stroke="var(--olive, #6D7550)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
    <text x="200" y="305" text-anchor="middle" font-family="'DM Mono', monospace" font-size="11" letter-spacing="2" fill="var(--muted, #6B6B6B)">IMAGE COMING SOON</text>
  </svg>
</div>
