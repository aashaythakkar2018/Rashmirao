{%- comment -%}
  The real cart. Unlike the static site's in-memory array, this reads
  cart.items, so it survives navigation and reloads, and "Proceed to Checkout"
  submits to Shopify's checkout instead of linking to the contact page.
{%- endcomment -%}

<div class="cart-scrim" id="cartScrim" onclick="closeCart()"></div>

<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true"
     aria-label="{{ 'sections.cart.title' | t }}">
  <div class="cart-top">
    <span class="cart-ttl">{{ 'sections.cart.title' | t }}</span>
    <button class="cart-x" onclick="closeCart()" aria-label="{{ 'accessibility.close' | t }}">&times;</button>
  </div>

  {%- comment -%}
    Always present (even empty) so refreshCart() - which only swaps
    #cartBody / #cartFoot / #cartTotal / #cartShipBar - has a stable target
    to update after every AJAX quantity change, add, or remove.
  {%- endcomment -%}
  <div id="cartShipBar">
    {%- if settings.enable_free_shipping_bar and settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
      {%- assign threshold_cents = settings.free_shipping_threshold | times: 100 -%}
      {%- assign ship_progress = cart.total_price | times: 100 | divided_by: threshold_cents -%}
      {%- assign ship_percent = ship_progress | at_most: 100 -%}
      <div class="cart-ship-bar">
        {%- if cart.total_price >= threshold_cents -%}
          <p><strong>{{ 'sections.cart.free_shipping_unlocked' | t }}</strong></p>
        {%- else -%}
          {%- assign remaining = threshold_cents | minus: cart.total_price -%}
          {%- assign remaining_money = remaining | money -%}
          <p>{{ 'sections.cart.free_shipping_progress_html' | t: amount: remaining_money }}</p>
        {%- endif -%}
        <div class="cart-ship-track"><div class="cart-ship-fill" style="width:{{ ship_percent }}%;"></div></div>
      </div>
    {%- endif -%}
  </div>

  <form action="{{ routes.cart_url }}" method="post" id="cartForm" novalidate>
    <div class="cart-body" id="cartBody">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty-msg">
          <p>{{ 'sections.cart.empty' | t }}</p>
          <p>{{ 'sections.cart.empty_subtext' | t }}</p>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}">
              <img class="cart-item-img"
                   src="{{ item.image | image_url: width: 160 }}"
                   alt="{{ item.image.alt | escape }}" width="80" height="80" loading="lazy">
            </a>
            <div class="cart-item-info">
              <a class="cart-item-name" href="{{ item.url }}">{{ item.product.title }}</a>
              <div class="cart-item-sub">
                {%- unless item.variant.title contains 'Default' -%}
                  {{ item.variant.title }}
                {%- else -%}
                  {{ item.product.type | default: 'Original' }}
                {%- endunless -%}
              </div>
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
              <div class="cart-item-qty">
                <div class="qty-stepper">
                  <button type="button" data-qty-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}">{% render 'icon-minus' %}</button>
                  <input type="number" min="0" value="{{ item.quantity }}" inputmode="numeric"
                         data-cart-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity' | t }} - {{ item.product.title | escape }}">
                  <button type="button" data-qty-step="1" aria-label="{{ 'accessibility.increase_quantity' | t }}">{% render 'icon-plus' %}</button>
                </div>
                <button type="button" class="cart-item-remove"
                        onclick="changeCartLine({{ forloop.index }}, 0)">{{ 'sections.cart.remove' | t }}</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="cart-foot" id="cartFoot" {% if cart.item_count == 0 %}style="display:none"{% endif %}>
      <div class="cart-total-row">
        <span class="cart-total-lbl">{{ 'sections.cart.subtotal' | t }}</span>
        <span class="cart-total-val" id="cartTotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-tax-note">{{ 'sections.cart.tax_note' | t }}</p>
      <button type="submit" name="checkout" class="btn-olive"
              style="width:100%;justify-content:center;"
              {% if cart.item_count == 0 %}disabled{% endif %}>
        {{ 'sections.cart.checkout' | t }}
      </button>
      <div class="cart-continue">
        <button type="button" onclick="closeCart()">{{ 'sections.cart.continue' | t }}</button>
      </div>
    </div>
  </form>
</div>
